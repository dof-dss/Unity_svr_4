<?php

/**
 * Search page titles.
 */
function coimisineir_theme_search_page_title() {
  $path = \Drupal::service('path.current')->getPath();

  $titles = [
    '/publications' => 'Foilseacháin',
    '/news' => 'Nuacht',
    '/search' => 'Cuardach',
  ];

  foreach ($titles as $page => $title) {
    if (strpos($path, $page) === 0) {
      return $title;
    }
  }
  return NULL;
}

/**
 * Implements hook_preprocess_page_title().
 */
function coimisineir_theme_preprocess_page_title(&$variables) {
  if ($title = coimisineir_theme_search_page_title()) {
    $variables['title'] = $title;
  }
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
function coimisineir_theme_preprocess_breadcrumb(&$variables) {
  if (empty($variables['breadcrumb'])) {
    return;
  }

  $title = coimisineir_theme_search_page_title();

  if (!$title) {
    return;
  }

  /*
   * Only translate the breadcrumb that represents the search page.
   *
   * Do NOT modify the last breadcrumb item because that is where
   * the selected Facet value is displayed.
   */
  $page_titles = [
    'Publications' => 'Foilseacháin',
    'News' => 'Nuacht',
    'Search' => 'Cuardach',
  ];

  foreach ($variables['breadcrumb'] as &$item) {
    $text = NULL;

    if (isset($item['text'])) {
      $text = $item['text'];
    }
    elseif (isset($item['#title'])) {
      $text = $item['#title'];
    }

    if ($text instanceof \Drupal\Core\StringTranslation\TranslatableMarkup) {
      $text = $text->render();
    }

    if (isset($page_titles[$text])) {
      if (isset($item['text'])) {
        $item['text'] = $title;
      }
      elseif (isset($item['#title'])) {
        $item['#title'] = $title;
      }

      break;
    }
  }
  unset($item);
}
